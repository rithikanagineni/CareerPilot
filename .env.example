# ============================================================
# CareerPilot — Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Next.js ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MCP Server ─────────────────────────────────────────────
# URL of the self-hosted MCP server (default: localhost:3001)
MCP_SERVER_URL=http://localhost:3001
MCP_PORT=3001

# ── Amazon Bedrock (AWS Builder Mini Challenge) ─────────────
# Set these to enable Amazon Bedrock AI generation.
# Without these, CareerPilot uses a deterministic fallback
# that clearly identifies itself as NOT Amazon Bedrock.
#
# Required IAM permissions:
#   bedrock:InvokeModel
#   bedrock:InvokeModelWithResponseStream (optional)
#
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model to use via Bedrock (ensure it is available in your AWS region/account)
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# ── Optional: Node env ─────────────────────────────────────
NODE_ENV=development
